  .loop-core { position: absolute; z-index: 3; top: 51%; left: 50%; width: 76px; height: 76px; display: grid; place-items: center; border: 1px solid rgba(23, 23, 22, 0.24); border-radius: 50%; background: #1c1c1a; color: #fff; box-shadow: 0 10px 25px rgba(20, 25, 20, 0.15); font-size: 1.6rem; font-weight: 690; letter-spacing: -0.08em; transform: translate(-50%, -50%); }
