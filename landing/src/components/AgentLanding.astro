  .section { padding: 8.5rem 0; }.split-heading { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(250px, 0.56fr); gap: 3rem; align-items: end; }.split-heading h2, .execution-top h2, .control-heading h2 { max-width: 700px; margin-top: 0.9rem; font-size: clamp(2.4rem, 4.3vw, 4.25rem); font-weight: 670; letter-spacing: -0.062em; line-height: 0.98; }.section-lede { color: #5e5d59; font-size: 1rem; line-height: 1.62; }.text-link { display: inline-flex; gap: 0.55rem; margin-top: 1.1rem; color: #276d58; font-size: 0.86rem; font-weight: 700; }.text-link:hover { text-decoration: underline; text-underline-offset: 0.2rem; }
  .context-section { background: #fff; }.question-grid { display: grid; grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.13fr); gap: 3rem; margin-top: 5.2rem; }.question-intro { color: #777772; font-family: var(--mono); font-size: 0.67rem; font-weight: 700; letter-spacing: 0.055em; line-height: 1.45; text-transform: uppercase; }.question-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }.question-list li { display: grid; grid-template-columns: 45px minmax(0, 1fr); gap: 1rem; padding: 1.15rem 0; border-bottom: 1px solid var(--line); }.question-list span { color: #7aae98; font-family: var(--mono); font-size: 0.67rem; font-weight: 700; }.question-list p { font-size: clamp(1.08rem, 1.6vw, 1.4rem); font-weight: 520; letter-spacing: -0.03em; line-height: 1.25; }

  .strategy-section { background: #f1f1ed; }.split-heading-tight { align-items: start; }.strategy-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.1rem; margin-top: 4rem; }.strategy-card { min-height: 385px; display: flex; flex-direction: column; padding: clamp(1.5rem, 3vw, 2.6rem); border: 1px solid rgba(23,23,22,0.14); border-radius: 0.65rem; overflow: hidden; }.strategy-card-mint { background: #c9e8db; }.strategy-card-sand { background: #eee4c5; }.strategy-topline { display: flex; justify-content: space-between; gap: 1rem; color: #4e5f56; font-family: var(--mono); font-size: 0.61rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }.strategy-card h3 { max-width: 390px; margin-top: 3.1rem; font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 670; letter-spacing: -0.055em; line-height: 1.01; }.strategy-card > p:not(.card-foot) { max-width: 420px; margin-top: 1rem; color: #4d5650; font-size: 0.94rem; line-height: 1.55; }.strategy-rule { display: flex; align-items: end; gap: 0.5rem; height: 54px; margin-top: auto; }.strategy-rule span { flex: 1; border-top: 2px solid rgba(23,23,22,0.45); transform-origin: left center; }.strategy-rule span:nth-child(1) { transform: translateY(13px) rotate(-13deg); }.strategy-rule span:nth-child(2) { transform: translateY(7px) rotate(18deg); }.strategy-rule span:nth-child(3) { transform: translateY(1px) rotate(-10deg); }.strategy-rule span:nth-child(4) { transform: translateY(-13px) rotate(17deg); }.copy-steps { display: flex; align-items: center; gap: 0.45rem; margin-top: auto; }.copy-steps i { width: 15%; height: 16px; display: block; border: 1px solid rgba(23,23,22,0.45); border-radius: 99px; }.copy-steps i:nth-child(2) { height: 27px; }.copy-steps i:nth-child(3) { height: 41px; background: rgba(255,255,255,0.38); }.copy-steps i:nth-child(4) { height: 30px; }.copy-steps i:nth-child(5) { height: 50px; }.card-foot { margin-top: 1rem; color: #5e625c; font-family: var(--mono); font-size: 0.61rem; f