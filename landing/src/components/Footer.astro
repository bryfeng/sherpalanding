---
import Brand from './Brand.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Brand />
        <p>The policy-aware trading platform for your agents.</p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div>
          <h2>Product</h2>
          <a href="#intelligence">Agent context</a>
          <a href="#automation">Strategies</a>
          <a href="#security">Execution</a>
        </div>
        <div>
          <h2>Explore</h2>
          <a href="#how-it-works">Control model</a>

          <a href="mailto:team@runsherpa.ai">Contact</a>
        </div>
      </nav>
    </div>

    <div class="risk-disclaimer" aria-labelledby="risk-title">
      <h2 id="risk-title">Risk disclosure</h2>
      <p>
        Crypto assets and decentralized finance involve substantial risk, including loss of principal. Agent-assisted, automated, and copy-trading strategies can lose money and may not execute as expected. Smart-contract, bridge, oracle, liquidity, market, network, and execution risks apply. Sherpa provides software and information, not investment, legal, or tax advice. You are responsible for agent instructions and the activity you review and authorize.
      </p>
    </div>

    <div class="footer-bottom">
      <p>© {year} Sherpa. All rights reserved.</p>
      <p>Non-custodial by design.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-20) 0 var(--space-8);
    background: var(--color-night);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-16);
  }

  .footer-brand > p {
    max-width: 380px;
    margin-top: var(--space-5);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }

  .footer-nav div {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .footer-nav h2,
  .risk-disclaimer h2 {
    margin-bottom: var(--space-2);
    color: #798981;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-nav a {
    width: fit-content;
    color: var(--text-muted);
    font-size: var(--text-sm);
    transition: color var(--duration-fast) ease;
  }

  .footer-nav a:hover {
    color: var(--text);
  }

  .risk-disclaimer {
    display: grid;
    grid-template-columns: 0.25fr 1fr;
    gap: var(--space-8);
    margin-top: var(--space-16);
    padding: var(--space-8) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .risk-disclaimer p {
    max-width: 900px;
    color: #84938c;
    font-size: var(--text-xs);
    line-height: 1.7;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-8);
    color: #6f7e77;
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  @media (max-width: 760px) {
    .footer-top,
    .risk-disclaimer {
      grid-template-columns: 1fr;
    }

    .footer-top {
      gap: var(--space-10);
    }

    .risk-disclaimer {
      gap: var(--space-3);
    }
  }

  @media (max-width: 460px) {
    .footer-nav {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
    }
  }
</style>
