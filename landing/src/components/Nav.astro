---
import Brand from './Brand.astro';
---

<header class="site-header">
  <nav class="nav container" aria-label="Primary navigation">
    <Brand />

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-menu"
      aria-label="Open navigation"
    >
      <span></span>
      <span></span>
    </button>

    <div class="nav-panel" id="primary-menu">
      <div class="nav-links">
        <a href="#intelligence">Agent context</a>
        <a href="#automation">Strategies</a>
        <a href="#security">Execution</a>
        <a href="#how-it-works">Control model</a>
      </div>
      <a class="button button-primary nav-cta" href="https://app.runsherpa.ai">Launch Sherpa</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.querySelector<HTMLElement>('.nav-panel');
  const panelLinks = panel?.querySelectorAll('a');

  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    panel?.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });

  panelLinks?.forEach((link) => link.addEventListener('click', () => setMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 820) setMenu(false);
  });
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    min-height: var(--nav-height);
    border-bottom: 1px solid var(--line);
    background: rgba(8, 17, 15, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .nav {
    display: flex;
    min-height: var(--nav-height);
    align-items: center;
    justify-content: space-between;
  }

  .nav-panel,
  .nav-links {
    display: flex;
    align-items: center;
  }

  .nav-panel {
    gap: clamp(1.5rem, 3vw, 3.5rem);
  }

  .nav-links {
    gap: clamp(1.1rem, 2.3vw, 2.25rem);
  }

  .nav-links a {
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
    transition: color var(--duration-fast) ease;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-cta {
    min-height: 2.7rem;
    padding-inline: 1.15rem;
  }

  .menu-toggle {
    display: none;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .menu-toggle span {
    position: absolute;
    width: 1rem;
    height: 1px;
    border-radius: var(--radius-full);
    background: currentColor;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .menu-toggle span:first-child {
    transform: translateY(-3px);
  }

  .menu-toggle span:last-child {
    transform: translateY(3px);
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: rotate(-45deg);
  }

  @media (max-width: 820px) {
    .menu-toggle {
      position: relative;
      display: grid;
    }

    .nav-panel {
      position: fixed;
      top: var(--nav-height);
      right: 0;
      left: 0;
      display: grid;
      min-height: calc(100svh - var(--nav-height));
      align-content: start;
      gap: var(--space-6);
      padding: 1.25rem 1rem 1.5rem;
      transform: translateY(-0.8rem);
      border-bottom: 1px solid var(--line);
      background: var(--color-night);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--duration-normal) ease,
        transform var(--duration-normal) var(--ease-out),
        visibility var(--duration-normal) ease;
    }

    .nav-panel.is-open {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-links {
      display: grid;
      gap: 0;
    }

    .nav-links a {
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--line);
      color: var(--text);
      font-size: 1rem;
    }

    .nav-cta {
      width: 100%;
    }
  }
</style>
