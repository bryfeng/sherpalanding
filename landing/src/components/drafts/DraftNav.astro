---
interface Props {
  current?: 'index' | 'alpine' | 'notes' | 'policy';
}

const { current = 'index' } = Astro.props;

const links = [
  { id: 'alpine', href: '/drafts/alpine-ledger/', number: '01', label: 'Alpine Ledger' },
  { id: 'notes', href: '/drafts/field-notes/', number: '02', label: 'Field Notes' },
  { id: 'policy', href: '/drafts/policy-route/', number: '03', label: 'Policy Route' }
];
---

<header class="draft-header">
  <nav class="draft-nav" aria-label="Redesign drafts">
    <a class="draft-brand" href="/drafts/" aria-label="Sherpa redesign drafts home">
      <span class="draft-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>Sherpa</span>
      <small>Design studies</small>
    </a>

    <div class="draft-links" aria-label="Choose a design direction">
      {links.map((link) => (
        <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>
          <span class="draft-number">{link.number}</span><span class="draft-label">{link.label}</span>
        </a>
      ))}
    </div>

    <a class="current-site" href="/">Current site <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<style>
  .draft-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--draft-rule);
    background: color-mix(in srgb, var(--draft-paper) 90%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .draft-nav {
    display: grid;
    width: min(calc(100% - 4rem), 1180px);
    min-height: 68px;
    margin-inline: auto;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .draft-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    width: fit-content;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .draft-brand small {
    margin-left: 0.35rem;
    color: var(--draft-muted);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .draft-mark {
    position: relative;
    display: grid;
    width: 1.85rem;
    height: 1.85rem;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .draft-mark i {
    position: absolute;
    width: 0.85rem;
    height: 1px;
    transform: rotate(-38deg);
    background: currentColor;
  }

  .draft-mark i:first-child {
    transform: translateY(-4px) rotate(-38deg);
  }

  .draft-mark i:last-child {
    transform: translateY(4px) rotate(-38deg);
  }

  .draft-links {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .draft-links a,
  .current-site {
    border-radius: 999px;
    color: var(--draft-muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .draft-links a {
    display: inline-flex;
    align-items: center;
    padding: 0.62rem 0.85rem;
  }

  .draft-links .draft-number {
    margin-right: 0.45rem;
    opacity: 0.58;
  }

  .draft-links a:hover,
  .draft-links a[aria-current='page'] {
    background: var(--draft-ink);
    color: var(--draft-paper);
  }

  .current-site {
    justify-self: end;
    padding-block: 0.55rem;
    color: var(--draft-ink);
  }

  .current-site:hover {
    color: var(--draft-accent-dark, var(--draft-accent));
  }

  @media (max-width: 900px) {
    .draft-nav {
      width: min(calc(100% - 2rem), 1180px);
      grid-template-columns: 1fr auto;
    }

    .draft-links {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-inline: -1rem;
      padding: 0 1rem 0.75rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .draft-links::-webkit-scrollbar {
      display: none;
    }

    .draft-links a {
      white-space: nowrap;
    }
  }

  @media (max-width: 520px) {
    .draft-brand small {
      display: none;
    }

    .current-site {
      font-size: 0.68rem;
    }

    .draft-links {
      display: grid;
      overflow: visible;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.3rem;
    }

    .draft-links a {
      display: grid;
      padding: 0.5rem 0.25rem;
      justify-items: center;
      gap: 0.08rem;
      font-size: 0.58rem;
      line-height: 1.25;
      text-align: center;
      white-space: normal;
    }

    .draft-links .draft-number {
      margin-right: 0;
      font-size: 0.52rem;
    }
  }
</style>
