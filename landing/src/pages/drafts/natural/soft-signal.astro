---
import NaturalDraftLayout from '../../../layouts/NaturalDraftLayout.astro';
import NaturalDraftNav from '../../../components/natural/NaturalDraftNav.astro';

const route = [
  { label: 'Portfolio', detail: 'The wallets and positions you connect' },
  { label: 'Context', detail: 'A question answered in plain language' },
  { label: 'Plan', detail: 'A strategy shaped by your policy' },
  { label: 'Wallet', detail: 'A review and signature only you provide' }
];
---

<NaturalDraftLayout
  title="Soft Signal — Natural-inspired Sherpa study"
  description="A calm, task-focused Sherpa landing direction inspired by Natural's interface language."
>
  <div class="signal-page">
    <NaturalDraftNav current="signal" />

    <main id="draft-main">
      <section class="hero" aria-labelledby="signal-title">
        <div class="mist mist-one" aria-hidden="true"></div>
        <div class="mist mist-two" aria-hidden="true"></div>

        <div class="signal-object" aria-label="Sherpa connects portfolio context, a policy, and wallet approval">
          <div class="signal-square" aria-hidden="true"><i></i></div>
          <span class="signal-arrow" aria-hidden="true">→</span>
          <div class="signal-nodes" aria-hidden="true">
            <i>p</i><i>?</i><i>✓</i>
          </div>
        </div>

        <p class="eyebrow">Portfolio intelligence, kept simple</p>
        <h1 id="signal-title">Start with the signal.<br />Keep control of the route.</h1>
        <p class="hero-copy">Sherpa helps you understand your onchain portfolio, consider a strategy, and prepare an action that still waits for your approval.</p>

        <div class="hero-actions" aria-label="Try the Soft Signal direction">
          <a class="primary-action" href="https://app.runsherpa.ai">Open Sherpa <span aria-hidden="true">↗</span></a>
          <a class="secondary-action" href="#route">See the route <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <section class="route" id="route" aria-labelledby="route-title">
        <div class="route-heading">
          <p>One useful path</p>
          <h2 id="route-title">From a question to a decision you own.</h2>
        </div>
        <ol>
          {route.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{item.label}</strong>
              <p>{item.detail}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="assurance" aria-label="Sherpa assurances">
        <div><span></span><p>You connect the portfolio context.</p></div>
        <div><span></span><p>You define the policy boundaries.</p></div>
        <div><span></span><p>You review and sign the execution.</p></div>
      </section>

      <footer>
        <p>Crypto assets and automated strategies involve market, protocol, and smart-contract risk. Sherpa does not guarantee outcomes or returns.</p>
        <a href="/drafts/natural/">All Natural studies <span aria-hidden="true">↗</span></a>
      </footer>
    </main>
  </div>
</NaturalDraftLayout>

<style is:global>
  .signal-page {
    --natural-ink: #161514;
    --natural-muted: #62615f;
    --natural-accent: #85d4bf;
    --natural-focus: #4d9b82;
    min-height: 100vh;
    background: #fff;
  }
</style>

<style>
  main {
    width: min(calc(100% - 3rem), 1080px);
    margin-inline: auto;
  }

  .hero {
    position: relative;
    display: grid;
    min-height: min(760px, calc(100svh - 64px));
    place-content: center;
    justify-items: center;
    overflow: hidden;
    padding: 5.5rem 1rem 4.5rem;
    text-align: center;
  }

  .mist {
    position: absolute;
    z-index: 0;
    width: 15rem;
    height: 15rem;
    border-radius: 40%;
    filter: blur(58px);
    opacity: 0.17;
    pointer-events: none;
  }

  .mist-one {
    top: 16%;
    left: 15%;
    background: #8ed8c1;
  }

  .mist-two {
    right: 12%;
    bottom: 18%;
    background: #f1dfa9;
  }

  .signal-object {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1.45rem;
    margin-bottom: 3.5rem;
  }

  .signal-square {
    position: relative;
    width: 7.5rem;
    height: 7.5rem;
    overflow: hidden;
    border-radius: 8px;
    background: #83cdb7;
  }

  .signal-square::before {
    position: absolute;
    inset: -45%;
    background: #c7f1df;
    content: '';
    filter: blur(30px);
    opacity: 0.7;
  }

  .signal-square i {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 1.3rem;
    height: 1.3rem;
    border: 1px solid rgba(22, 21, 20, 0.52);
    border-radius: 50%;
  }

  .signal-arrow {
    color: #aaa9a6;
    font-size: 2.25rem;
    font-weight: 300;
  }

  .signal-nodes {
    position: relative;
    display: grid;
    width: 5.2rem;
    height: 6rem;
    grid-template-columns: repeat(2, 1fr);
    align-items: center;
  }

  .signal-nodes i {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 50%;
    background: #f0efec;
    color: var(--natural-ink);
    font-size: 0.8rem;
    font-style: normal;
  }

  .signal-nodes i:nth-child(2) {
    align-self: end;
    background: #ece3c9;
  }

  .signal-nodes i:nth-child(3) {
    grid-column: 2;
    background: #c9e9dc;
  }

  .eyebrow,
  .route-heading > p,
  .route li > span {
    position: relative;
    z-index: 1;
    color: var(--natural-muted);
    font-size: 0.67rem;
    letter-spacing: -0.04em;
  }

  h1,
  h2 {
    position: relative;
    z-index: 1;
    font-weight: 400;
    letter-spacing: -0.08em;
  }

  h1 {
    max-width: 820px;
    margin-top: 1.25rem;
    font-size: clamp(2.75rem, 6vw, 5.8rem);
    line-height: 0.98;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin-top: 1.4rem;
    color: var(--natural-muted);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .hero-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.9rem;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 0.7rem 0.95rem;
    border-radius: 8px;
    font-size: 0.72rem;
    letter-spacing: -0.04em;
    transition: transform 160ms ease, background-color 160ms ease;
  }

  .primary-action {
    background: var(--natural-ink);
    color: #fff;
  }

  .primary-action:hover {
    transform: translateY(-2px);
  }

  .secondary-action {
    background: #f3f3f2;
  }

  .secondary-action:hover {
    background: #e8e8e7;
  }

  .route {
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-top: 1px solid #ececeb;
  }

  .route-heading {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    align-items: start;
    gap: 2rem;
  }

  h2 {
    max-width: 740px;
    font-size: clamp(2.25rem, 4.5vw, 4.5rem);
    line-height: 1;
  }

  .route ol {
    display: grid;
    margin-top: 4.5rem;
    border-top: 1px solid #ececeb;
    grid-template-columns: repeat(4, 1fr);
  }

  .route li {
    min-height: 180px;
    padding: 1rem 1.2rem 1rem 0;
    border-right: 1px solid #ececeb;
  }

  .route li + li {
    padding-left: 1.2rem;
  }

  .route li:last-child {
    border-right: 0;
  }

  .route li > span {
    color: #82b9a7;
  }

  .route strong {
    display: block;
    margin-top: 3rem;
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: -0.05em;
  }

  .route li p {
    max-width: 170px;
    margin-top: 0.55rem;
    color: var(--natural-muted);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .assurance {
    display: grid;
    padding: 1.1rem 1.25rem;
    border-radius: 12px;
    background: #f5f5f4;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .assurance div {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .assurance span {
    width: 0.42rem;
    height: 0.42rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #85d4bf;
  }

  .assurance p {
    font-size: 0.68rem;
    letter-spacing: -0.04em;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.8rem 0 2.8rem;
    color: var(--natural-muted);
    font-size: 0.6rem;
    line-height: 1.55;
  }

  footer p {
    max-width: 670px;
  }

  footer a {
    color: var(--natural-ink);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    main {
      width: min(calc(100% - 2rem), 1080px);
    }

    .hero {
      min-height: 650px;
    }

    .route-heading {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .route ol {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 0;
    }

    .route li:nth-child(2) {
      border-right: 0;
    }

    .assurance {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 620px;
      padding-inline: 0;
    }

    .signal-object {
      margin-bottom: 2.5rem;
      transform: scale(0.82);
    }

    h1 {
      font-size: clamp(2.55rem, 12vw, 3.6rem);
    }

    .hero-actions {
      display: grid;
      width: 100%;
    }

    .route ol {
      margin-top: 3rem;
      grid-template-columns: 1fr;
    }

    .route li,
    .route li + li {
      min-height: auto;
      padding: 1rem 0;
      border-right: 0;
      border-bottom: 1px solid #ececeb;
    }

    .route strong {
      margin-top: 1.5rem;
    }

    footer {
      display: grid;
    }
  }
</style>
