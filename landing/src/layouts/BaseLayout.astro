---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sherpa — The trading platform for your agents',
  description = 'Give your agents portfolio context and policy-aware trading workflows across chains. You define the mandate, keep custody, and control authorization.'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://runsherpa.ai');
const socialImageURL = new URL('/og.png', 'https://runsherpa.ai');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08110f" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sherpa" />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1734" />
    <meta property="og:image:height" content="907" />
    <meta property="og:image:alt" content="Sherpa — The trading platform for your agents." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content="Sherpa — The trading platform for your agents." />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
